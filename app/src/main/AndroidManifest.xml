        android:supportsRtl="true"
        android:theme="@style/Theme.MaterialComponents.Light.NoActionBar">
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyBvvkf30-4wzenU5SJuxbO0DosDNx81Lv4" />

        <activity
            android:name=".ui.DashboardActivity"
            android:exported="false" />

        <activity android:name=".ui.LoginActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.EmployeeActivity" android:exported="false" />
        <activity android:name=".ui.DepartmentActivity" android:exported="false" android:theme="@style/Theme.MyApplication" />
        <activity android:name=".ui.DepartmentDetailActivity" android:exported="false" android:theme="@style/Theme.MyApplication" />
        <activity android:name=".ui.RequestActivity" android:exported="false" />
        <activity android:name=".ui.TaskActivity" android:exported="false" />
        <activity android:name=".ui.TimekeepingActivity" android:exported="false" />
        <activity android:name=".ui.ChatActivity" android:exported="false" />
        <activity android:name=".ui.MessageActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.SelectEmployeeActivity" android:exported="false" />
        <activity android:name=".ui.NotificationActivity" android:exported="false" />
        <activity android:name=".ui.ProfileActivity" android:exported="false" />
        <activity android:name=".ui.PayrollActivity" android:exported="false" />
        <activity android:name=".ui.AdminPayrollActivity" android:exported="false" />
        <activity android:name=".ui.GPSCheckInActivity" android:exported="false" />
        <activity android:name=".ui.AdminSettingsActivity" android:exported="false" />
        <activity android:name=".ui.AttendanceSummaryActivity" android:exported="false" />
        <activity android:name=".ui.AdminMainActivity" android:exported="false" />
        <activity android:name=".ui.AddEditEmployeeActivity" android:exported="false" />
        <activity android:name=".ui.AccountManagementActivity" android:exported="false" />
        <activity android:name=".ui.SystemLogActivity" android:exported="false" />
