<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardAttendance"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E5E7EB"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Status Bar -->
        <View
            android:id="@+id/statusBar"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="#10B981" />

        <!-- Date Section -->
        <LinearLayout
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tvDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="13"
                android:textSize="32sp"
                android:textColor="#111827"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tvMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thg 3"
                android:textSize="12sp"
                android:textColor="#6B7280"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tvWeekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thứ Sáu"
                android:textSize="11sp"
                android:textColor="#9CA3AF"
                android:layout_marginTop="2dp"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#E5E7EB"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- Time Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Check In -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_login"
                    app:tint="#10B981" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/check_in"
                    android:textSize="12sp"
                    android:textColor="#6B7280"
                    android:layout_marginStart="6dp" />

                <TextView
                    android:id="@+id/tvCheckIn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="08:05"
                    android:textSize="14sp"
                    android:textColor="#111827"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvLateBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+5'"
                    android:textSize="11sp"
                    android:textColor="#EF4444"
                    android:background="#FEE2E2"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_marginStart="8dp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <!-- Check Out -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_logout"
                    app:tint="#EF4444" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/check_out"
                    android:textSize="12sp"
                    android:textColor="#6B7280"
                    android:layout_marginStart="6dp" />

                <TextView
                    android:id="@+id/tvCheckOut"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="17:30"
                    android:textSize="14sp"
                    android:textColor="#111827"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <!-- Total Hours -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_clock"
                    app:tint="#1976D2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total"
                    android:textSize="12sp"
                    android:textColor="#6B7280"
                    android:layout_marginStart="6dp" />

                <TextView
                    android:id="@+id/tvTotalHours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9.25 giờ"
                    android:textSize="14sp"
                    android:textColor="#1976D2"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

        </LinearLayout>

        <!-- Status Badge -->
        <com.google.android.material.chip.Chip
            android:id="@+id/statusChip"
            style="@style/Widget.MaterialComponents.Chip.Action"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/status_on_time"
            android:textSize="11sp"
            android:textColor="#10B981"
            app:chipBackgroundColor="#ECFDF5"
            app:chipIcon="@drawable/ic_check_circle"
            app:chipIconSize="16dp"
            app:chipIconTint="#10B981"
            app:chipMinHeight="32dp"
            android:layout_gravity="top" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>