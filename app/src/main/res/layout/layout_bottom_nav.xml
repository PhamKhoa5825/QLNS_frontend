<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_nav"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_bottom_nav"
    android:layout_gravity="bottom"
    android:gravity="center"
    android:paddingTop="12dp"
    android:paddingBottom="24dp"
    android:paddingHorizontal="16dp"
    android:elevation="16dp">

    <!-- Home -->
    <FrameLayout
        android:id="@+id/nav_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/pill_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:paddingHorizontal="12dp">
            <ImageView
                android:id="@+id/icon_home"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/secondary" />
            <TextView
                android:id="@+id/text_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Home"
                android:textColor="@color/secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- People -->
    <FrameLayout
        android:id="@+id/nav_people"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/pill_people"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:paddingHorizontal="12dp">
            <ImageView
                android:id="@+id/icon_people"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_people"
                app:tint="@color/secondary" />
            <TextView
                android:id="@+id/text_people"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="People"
                android:textColor="@color/secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
    
    <!-- Chat -->
    <FrameLayout
        android:id="@+id/nav_chat"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/pill_chat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:paddingHorizontal="12dp">
            <ImageView
                android:id="@+id/icon_chat"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_chat"
                app:tint="@color/secondary" />
            <TextView
                android:id="@+id/text_chat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Chat"
                android:textColor="@color/secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
    
    <!-- Tasks -->
    <FrameLayout
        android:id="@+id/nav_tasks"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/pill_tasks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:paddingHorizontal="12dp">
            <ImageView
                android:id="@+id/icon_tasks"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_tasks"
                app:tint="@color/secondary" />
            <TextView
                android:id="@+id/text_tasks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tasks"
                android:textColor="@color/secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
    
    <!-- Approval -->
    <FrameLayout
        android:id="@+id/nav_request"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/pill_request"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:paddingHorizontal="12dp">
            <ImageView
                android:id="@+id/icon_request"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_approve"
                app:tint="@color/secondary" />
            <TextView
                android:id="@+id/text_request"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Duyệt đơn"
                android:textColor="@color/secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- Admin (Conditional Visibility) -->
    <FrameLayout
        android:id="@+id/nav_admin"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/pill_admin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:paddingHorizontal="12dp">
            <ImageView
                android:id="@+id/icon_admin"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_admin"
                app:tint="@color/secondary" />
            <TextView
                android:id="@+id/text_admin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Quản trị"
                android:textColor="@color/secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
