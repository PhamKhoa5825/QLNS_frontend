<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeColor="#E5E7EB"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Top Header: Avatar & Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">
                <TextView
                    android:id="@+id/tvDetailAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="#F3F0FF"
                    android:gravity="center"
                    android:textColor="#7C3AED"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:text="A" />
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivDetailAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/CircleImageAppearance" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDetailEmployeeName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Người thực hiện"
                    android:textColor="#111827"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailDept"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phòng ban"
                    android:textColor="#6B7280"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnModalClose"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:alpha="0.4"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F3F4F6"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"/>

        <!-- Title and Priority -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tiêu đề nhiệm vụ"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailPriority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_status_pill"
                android:backgroundTint="#FEF3C7"
                android:text="MEDIUM"
                android:textColor="#D97706"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Status Badge -->
        <TextView
            android:id="@+id/tvDetailStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_status_pill"
            android:backgroundTint="#DBEAFE"
            android:text="PENDING"
            android:textColor="#2563EB"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Deadline & Creation Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:padding="14dp"
            android:background="#F9FAFB">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="Hạn chót:"
                    android:textColor="#9CA3AF"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvDetailDeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2024-04-01"
                    android:textColor="#374151"
                    android:textStyle="bold"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="Người giao:"
                    android:textColor="#9CA3AF"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvDetailCreator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Admin"
                    android:textColor="#374151"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Description Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Mô tả nhiệm vụ:"
            android:textColor="#9CA3AF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetailDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Nội dung chi tiết của nhiệm vụ sẽ được hiển thị ở đây. Nó có thể dài nhiều dòng để mô tả đầy đủ các yêu cầu cần thực hiện."
            android:textColor="#4B5563"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <!-- Input Note/Report Section (Dynamic) -->
        <LinearLayout
            android:id="@+id/layoutDetailActionInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:visibility="gone">
            
            <TextView
                android:id="@+id/tvLabelActionNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Báo cáo hoàn thành / Phản hồi:"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtDetailNote"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:gravity="top"
                android:padding="12dp"
                android:hint="Nhập nội dung tại đây..."
                android:textColor="#1F2937"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Footer Actions -->
        <LinearLayout
            android:id="@+id/layoutDetailActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailSecondaryAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Yêu cầu sửa lại"
                android:textColor="#F43F5E"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:paddingVertical="8dp"
                android:paddingHorizontal="4dp"
                app:cornerRadius="12dp"
                android:visibility="gone"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="#F43F5E"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailPrimaryAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Duyệt"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:paddingVertical="8dp"
                android:textColor="@android:color/white"
                app:cornerRadius="12dp"
                android:visibility="gone"
                app:backgroundTint="#7C3AED"
                app:elevation="0dp"/>

        </LinearLayout>

        <!-- Close Button (Always visible) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailClose"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="Đóng"
            android:textColor="#4B5563"
            android:textAllCaps="false"
            app:cornerRadius="12dp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            app:backgroundTint="#F3F4F6"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
