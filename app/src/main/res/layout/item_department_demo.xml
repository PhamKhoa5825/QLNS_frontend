<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E6E0E9"
    app:cardBackgroundColor="?attr/colorSurface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgDeptIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="#EADDFF"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
            app:tint="#21005D" />

        <TextView
            android:id="@+id/tvDeptName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:text="Công nghệ thông tin"
            android:textColor="#1D1B20"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/imgNext"
            app:layout_constraintStart_toEndOf="@id/imgDeptIcon"
            app:layout_constraintTop_toTopOf="@id/imgDeptIcon" />

        <TextView
            android:id="@+id/tvManagerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Trưởng phòng: Nguyễn Văn A"
            android:textColor="#49454F"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="@id/tvDeptName"
            app:layout_constraintStart_toStartOf="@id/tvDeptName"
            app:layout_constraintTop_toBottomOf="@id/tvDeptName" />

        <TextView
            android:id="@+id/tvEmpCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawableStart="@android:drawable/ic_menu_myplaces"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:text="25 người"
            android:textColor="#49454F"
            android:textSize="12sp"
            app:drawableTint="#49454F"
            app:layout_constraintStart_toStartOf="@id/tvDeptName"
            app:layout_constraintTop_toBottomOf="@id/tvManagerName" />

        <ImageView
            android:id="@+id/imgNext"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_media_next"
            app:layout_constraintBottom_toBottomOf="@id/imgDeptIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/imgDeptIcon"
            app:tint="#CAC4D0" />

        <TextView
            android:id="@+id/labelPerf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Hiệu suất làm việc"
            android:textColor="#49454F"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEmpCount" />

        <TextView
            android:id="@+id/tvPerformanceStr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="92%"
            android:textColor="#1D1B20"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/labelPerf"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/labelPerf" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:progress="92"
            app:indicatorColor="#6750A4"
            app:trackColor="#E6E0E9"
            app:trackCornerRadius="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/labelPerf" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>