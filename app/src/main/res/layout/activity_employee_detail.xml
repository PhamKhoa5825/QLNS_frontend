<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F4F6">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:background="@drawable/bg_header_inner"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:navigationIconTint="@color/white"
            app:title="Chi tiết nhân viên"
            app:titleTextColor="@color/white" />
    </com.google.android.material.appbar.AppBarLayout>


    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/layoutInfo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_marginBottom="24dp">
 
                        <FrameLayout
                            android:layout_width="80dp"
                            android:layout_height="80dp">
 
                            <ImageView
                                android:id="@+id/ivDetailAvatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_avatar_light_blue"
                                android:scaleType="centerCrop"
                                android:visibility="gone" />
 
                            <TextView
                                android:id="@+id/tvDetailAvatarFallback"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_avatar_light_blue"
                                android:gravity="center"
                                android:text="A"
                                android:textColor="#2563EB"
                                android:textSize="32sp"
                                android:textStyle="bold" />
                        </FrameLayout>
 
                        <TextView
                            android:id="@+id/tvDetailHeaderName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Nguyễn Văn A"
                            android:textColor="@color/textColorPrimary"
                            android:textSize="20sp"
                            android:textStyle="bold" />
 
                        <TextView
                            android:id="@+id/tvDetailHeaderRole"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nhân viên"
                            android:textColor="@color/colorPrimary"
                            android:textSize="14sp" />
                    </LinearLayout>
 
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Thông tin chi tiết" android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/textColorPrimary" android:layout_marginBottom="12dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Họ tên" android:textSize="12sp" android:textColor="@color/textColorSecondary" />
                    <TextView android:id="@+id/tvDetailName" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="—" android:textSize="15sp" android:textColor="@color/textColorPrimary"
                        android:layout_marginBottom="10dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Email" android:textSize="12sp" android:textColor="@color/textColorSecondary" />
                    <TextView android:id="@+id/tvDetailEmail" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="—" android:textSize="15sp" android:textColor="@color/textColorPrimary"
                        android:layout_marginBottom="10dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Số điện thoại" android:textSize="12sp" android:textColor="@color/textColorSecondary" />
                    <TextView android:id="@+id/tvDetailPhone" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="—" android:textSize="15sp" android:textColor="@color/textColorPrimary"
                        android:layout_marginBottom="10dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Phòng ban" android:textSize="12sp" android:textColor="@color/textColorSecondary" />
                    <TextView android:id="@+id/tvDetailDept" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="—" android:textSize="15sp" android:textColor="@color/textColorPrimary"
                        android:layout_marginBottom="10dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Chức vụ" android:textSize="12sp" android:textColor="@color/textColorSecondary" />
                    <TextView android:id="@+id/tvDetailPosition" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="—" android:textSize="15sp" android:textColor="@color/textColorPrimary"
                        android:layout_marginBottom="10dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Ngày vào làm" android:textSize="12sp" android:textColor="@color/textColorSecondary" />
                    <TextView android:id="@+id/tvDetailJoinDate" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="—" android:textSize="15sp" android:textColor="@color/textColorPrimary"
                        android:layout_marginBottom="10dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Trạng thái" android:textSize="12sp" android:textColor="@color/textColorSecondary" />
                    <TextView android:id="@+id/tvDetailStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="—" android:textSize="15sp" android:textColor="@color/textColorPrimary" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Admin Actions -->
            <LinearLayout
                android:id="@+id/layoutAdminActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReactivate"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Kích hoạt lại"
                    android:textColor="#10B981"
                    app:strokeColor="#10B981"
                    app:cornerRadius="8dp"
                    android:textAllCaps="false"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    app:icon="@android:drawable/ic_menu_revert"
                    app:iconTint="#10B981" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
