<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Handle bar -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:background="#E5E7EB" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bộ lọc nâng cao"
            android:textColor="#111827"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- ── Chức vụ ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="Chức vụ"
            android:textColor="#374151"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!--
            cgRole: load động từ API danh sách position
            Trong Activity dùng: addChipToGroup(cgRole, "Lập trình viên")
        -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingVertical="4dp"
            app:singleSelection="false" />

        <!-- ── Phòng ban ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="Phòng ban"
            android:textColor="#374151"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!--
            cgDepartment: load động từ API GET /api/departments
            Trong Activity gọi loadDepartmentChips(cgDepartment)
        -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgDepartment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingVertical="4dp"
            app:singleSelection="false" />

        <!-- ── Trạng thái ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="Trạng thái"
            android:textColor="#374151"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!--
            cgStatus: 2 chip cố định: Đang làm việc / Đã nghỉ việc
            Thêm trong Activity khi tạo dialog
        -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingVertical="4dp"
            app:singleSelection="true" />

        <!-- ── Nút hành động ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Xoá bộ lọc -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReset"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Xoá bộ lọc"
                android:textAllCaps="false"
                android:textSize="15sp"
                app:cornerRadius="28dp"/>

            <!-- Áp dụng -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApply"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Áp dụng"
                android:textAllCaps="false"
                android:textSize="15sp"
                app:backgroundTint="@color/colorPrimary"
                app:cornerRadius="28dp" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>