<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:background="#E5E7EB" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bộ lọc nâng cao"
            android:textColor="#111827"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView style="@style/FilterLabelStyle" android:text="Chức vụ" />
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingVertical="4dp" />

        <TextView style="@style/FilterLabelStyle" android:text="Phòng ban" />
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgDepartment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView style="@style/FilterLabelStyle" android:text="Trạng thái" />
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="Gửi"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:backgroundTint="#000000"
            app:cornerRadius="28dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>