<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- SCROLLABLE CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- HEADER -->
            <View android:id="@+id/headerBg" android:layout_width="match_parent" android:layout_height="220dp"
                android:clickable="false" android:focusable="false"
                android:background="@drawable/bg_header_dashboard" app:layout_constraintTop_toTopOf="parent" />

            <TextView android:id="@+id/tvAvatar" android:layout_width="48dp" android:layout_height="48dp"
                android:layout_marginStart="24dp" android:layout_marginTop="24dp"
                android:background="@drawable/bg_avatar_circle" android:backgroundTint="@color/soft_primary"
                android:gravity="center" android:text="N" android:textColor="@color/colorPrimaryDark"
                android:textSize="20sp" android:elevation="0dp"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

            <TextView android:id="@+id/tvGreeting" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:text="Xin chào," android:textColor="#E0E0E0" android:textSize="14sp"
                app:layout_constraintStart_toEndOf="@id/tvAvatar" app:layout_constraintTop_toTopOf="@id/tvAvatar" />

            <TextView android:id="@+id/tvUserName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:text="Nguyễn Văn A" android:textColor="@color/white"
                android:textSize="18sp" android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/tvAvatar" app:layout_constraintTop_toBottomOf="@id/tvGreeting" />

            <ImageView android:id="@+id/btnNavLogout" android:layout_width="40dp" android:layout_height="40dp"
                android:clickable="true" android:focusable="true" android:elevation="8dp"
                android:layout_marginEnd="24dp" android:padding="8dp" android:src="@drawable/ic_logout"
                android:background="?attr/selectableItemBackgroundBorderless" app:tint="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvAvatar" app:layout_constraintBottom_toBottomOf="@id/tvAvatar" />

            <!-- DATE + TIME -->
            <LinearLayout android:id="@+id/layoutDate" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp" android:layout_marginTop="24dp"
                android:background="@drawable/bg_input" android:backgroundTint="#33FFFFFF"
                android:orientation="horizontal" android:padding="16dp" android:elevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/tvAvatar">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_my_calendar" app:tint="@color/white" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Hôm nay" android:textColor="#E0E0E0" android:textSize="12sp" />
                    <TextView android:id="@+id/tvCurrentDate" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/tvCurrentTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="--:--" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- STATS ViewPager2 -->
            <TextView android:id="@+id/tvStatsTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="24dp" android:layout_marginTop="20dp"
                android:text="Thống kê" android:textColor="@color/textColorPrimary"
                android:textSize="16sp" android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutDate" />

            <TextView android:id="@+id/tvStatsPageInfo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginEnd="24dp" android:text="1/2" android:textColor="@color/textColorSecondary"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvStatsTitle"
                app:layout_constraintBottom_toBottomOf="@id/tvStatsTitle" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vpStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                app:layout_constraintTop_toBottomOf="@id/tvStatsTitle" />

            <LinearLayout android:id="@+id/layoutDots"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/vpStats" />

            <!-- QUICK ACCESS - 2 rows x 3 cols (chức năng chính) -->
            <TextView android:id="@+id/tvQuickAccess" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="24dp" android:layout_marginTop="20dp" android:text="Truy cập nhanh"
                android:textColor="@color/textColorPrimary" android:textSize="16sp" android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/layoutDots" />

            <!-- Row 1: Nhân viên · Phòng ban · Thông báo -->
            <LinearLayout android:id="@+id/layoutMenu" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:gravity="center" android:orientation="horizontal" android:weightSum="3"
                app:layout_constraintTop_toBottomOf="@id/tvQuickAccess">

                <LinearLayout android:id="@+id/btnNavEmployee" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
                    <com.google.android.material.card.MaterialCardView android:layout_width="60dp" android:layout_height="60dp"
                        app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/soft_primary">
                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp"
                            android:src="@drawable/outline_contacts_product_24" app:tint="@color/colorPrimary" />
                    </com.google.android.material.card.MaterialCardView>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="Nhân viên" android:textSize="12sp" android:textColor="@color/textColorPrimary" />
                </LinearLayout>

                <LinearLayout android:id="@+id/btnNavDepartment" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
                    <com.google.android.material.card.MaterialCardView android:layout_width="60dp" android:layout_height="60dp"
                        app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/soft_purple">
                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp"
                            android:src="@drawable/outline_apartment_24" app:tint="@color/deep_purple" />
                    </com.google.android.material.card.MaterialCardView>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="Phòng ban" android:textSize="12sp" android:textColor="@color/textColorPrimary" />
                </LinearLayout>

                <LinearLayout android:id="@+id/btnNavNotification" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
                    <com.google.android.material.card.MaterialCardView android:layout_width="60dp" android:layout_height="60dp"
                        app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/soft_red">
                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp"
                            android:src="@android:drawable/ic_popup_reminder" app:tint="@color/deep_red" />
                    </com.google.android.material.card.MaterialCardView>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="Thông báo" android:textSize="12sp" android:textColor="@color/textColorPrimary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2: Đơn từ · Tài khoản -->
            <LinearLayout android:id="@+id/layoutMenu2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:layout_marginBottom="24dp" android:gravity="center"
                android:orientation="horizontal" android:weightSum="3"
                app:layout_constraintTop_toBottomOf="@id/layoutMenu">

                <LinearLayout android:id="@+id/btnNavRequest" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
                    <com.google.android.material.card.MaterialCardView android:layout_width="60dp" android:layout_height="60dp"
                        app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/soft_orange">
                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp"
                            android:src="@android:drawable/ic_menu_send" app:tint="@color/deep_orange" />
                    </com.google.android.material.card.MaterialCardView>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="Đơn từ" android:textSize="12sp" android:textColor="@color/textColorPrimary" />
                </LinearLayout>

                <LinearLayout android:id="@+id/btnNavAccount" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
                    <com.google.android.material.card.MaterialCardView android:layout_width="60dp" android:layout_height="60dp"
                        app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/soft_blue">
                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp"
                            android:src="@drawable/outline_account_circle_24" app:tint="@color/deep_blue" />
                    </com.google.android.material.card.MaterialCardView>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="Tài khoản" android:textSize="12sp" android:textColor="@color/textColorPrimary" />
                </LinearLayout>

                <LinearLayout android:id="@+id/btnNavBackup" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
                    <com.google.android.material.card.MaterialCardView android:layout_width="60dp" android:layout_height="60dp"
                        app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="#EDE9FE">
                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp"
                            android:src="@android:drawable/ic_menu_save" app:tint="#7C3AED" />
                    </com.google.android.material.card.MaterialCardView>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="Sao lưu" android:textSize="12sp" android:textColor="@color/textColorPrimary" />
                </LinearLayout>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM NAVIGATION BAR -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="8dp"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/textColorSecondary"
        app:itemTextColor="@color/textColorSecondary"
        app:menu="@menu/menu_bottom_nav" />

</LinearLayout>