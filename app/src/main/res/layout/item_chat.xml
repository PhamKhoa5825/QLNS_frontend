<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp">

    <FrameLayout
        android:id="@+id/frameAvatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvChatAvatar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_avatar_pink_light"
            android:gravity="center"
            android:text="N"
            android:textColor="#E91E63"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/viewOnlineDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_online_dot" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvChatName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:text="Nguyễn Văn A"
        android:textColor="@color/textColorPrimary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/tvChatTime"
        app:layout_constraintStart_toEndOf="@id/frameAvatar"
        app:layout_constraintTop_toTopOf="@id/frameAvatar" />

    <TextView
        android:id="@+id/tvChatTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10:30"
        android:textColor="@color/textColorSecondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvChatName" />

    <TextView
        android:id="@+id/tvChatMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Báo cáo đã gửi cho anh rồi nhé"
        android:textColor="@color/textColorSecondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@id/tvUnreadCount"
        app:layout_constraintStart_toStartOf="@id/tvChatName"
        app:layout_constraintTop_toBottomOf="@id/tvChatName" />

    <TextView
        android:id="@+id/tvChatDepartment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="IT"
        android:textColor="#9CA3AF"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/tvChatName"
        app:layout_constraintTop_toBottomOf="@id/tvChatMessage" />

    <TextView
        android:id="@+id/tvUnreadCount"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/bg_badge_pink"
        android:gravity="center"
        android:text="2"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/tvChatMessage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvChatMessage" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#E5E7EB"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tvChatName"
        app:layout_constraintTop_toBottomOf="@id/tvChatDepartment" />

</androidx.constraintlayout.widget.ConstraintLayout>