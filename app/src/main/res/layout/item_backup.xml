<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Row 1: filename + size -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_save"
                app:tint="@color/colorPrimary" />

            <TextView
                android:id="@+id/tvBackupFilename"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="backup_2026-03-25.sql"
                android:textSize="13sp"
                android:textColor="@color/textColorPrimary"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/tvBackupSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="125.3 KB"
                android:textSize="12sp"
                android:textColor="@color/textColorSecondary" />
        </LinearLayout>

        <!-- Row 2: date -->
        <TextView
            android:id="@+id/tvBackupDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="32dp"
            android:text="2026-03-25 02:00:00"
            android:textSize="11sp"
            android:textColor="@color/textColorSecondary" />

        <!-- Row 3: action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownload"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Tải xuống"
                android:textSize="12sp"
                android:textAllCaps="false"
                app:icon="@android:drawable/stat_sys_download"
                app:iconSize="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestore"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Khôi phục"
                android:textSize="12sp"
                android:textColor="#F59E0B"
                android:textAllCaps="false"
                app:icon="@android:drawable/ic_menu_revert"
                app:iconSize="16dp"
                app:iconTint="#F59E0B" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteBackup"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Xóa"
                android:textSize="12sp"
                android:textColor="#EF4444"
                android:textAllCaps="false"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconSize="16dp"
                app:iconTint="#EF4444" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
